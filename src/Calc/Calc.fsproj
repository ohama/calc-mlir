<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Version>0.30.0</Version>
    <!-- 평가기의 tail call(evalIn → apply → evalIn)이 스택을 쓰지 않도록 Debug 에서도 .tail 호출을 냄.
         Calc 로 쓴 prelude(map, range 등)가 tail recursion 이라서, 빌드 구성에 따라 깊이 한계가 달라지면 안 됨 -->
    <Tailcalls>true</Tailcalls>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Ast.fs" />
    <Compile Include="Errors.fs" />
    <Compile Include="Eval.fs" />
    <Compile Include="Infer.fs" />
    <Compile Include="Core.fs" />
    <Compile Include="Lower.fs" />
    <Compile Include="Codegen.fs" />
    <Compile Include="Toolchain.fs" />
    <FsYacc Include="Parser.fsy">
      <OtherFlags>--module Parser</OtherFlags>
    </FsYacc>
    <FsLex Include="Lexer.fsl">
      <OtherFlags>--module Lexer --unicode</OtherFlags>
    </FsLex>
    <Compile Include="Parser.fsi" />
    <Compile Include="Parser.fs" />
    <Compile Include="Lexer.fs" />
    <Compile Include="Frontend.fs" />
    <Compile Include="Prelude.fs" />
    <Compile Include="Repl.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Calc 로 쓴 표준 라이브러리. Prelude.source 가 읽음 -->
    <EmbeddedResource Include="prelude.calc" LogicalName="prelude.calc" />
  </ItemGroup>

  <ItemGroup>
    <!-- 컴파일러가 실행 파일을 만들 때 함께 컴파일하는 C 런타임 -->
    <None Include="runtime\*.c;runtime\*.h" CopyToOutputDirectory="PreserveNewest" LinkBase="runtime" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Argu" Version="6.2.5" />
    <PackageReference Include="FsLexYacc" Version="11.3.0" />
  </ItemGroup>

</Project>
