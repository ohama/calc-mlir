// Calc 표준 라이브러리 (prelude). 프로그램 앞에 붙어서 인터프리터, 타입 추론, 컴파일러가 같은 정의를 씀.
// 프로그램이 쓰는 정의만 붙음 (Prelude.wrap). 프로그램에서 같은 이름을 정의하면 그쪽이 가림.
// 긴 리스트에서도 스택이 자라지 않도록 모두 tail recursion: map, filter 는 거꾸로 모은 뒤 reverse.
// 여러 타입을 받는 함수(length, sort), 문자열과 출력 함수, raise 는 내장 함수.

// 예외: Failure msg 를 raise. 받는 try 가 없으면 "Error: <msg>" (내장 함수의 오류와 같은 모양)
let failwith msg = raise (Failure msg)

// 튜플, unit
let fst p =
    match p with
    | (a, _) -> a

let snd p =
    match p with
    | (_, b) -> b

let ignore _ = ()

// 리스트: 고차 함수는 F# List 처럼 함수가 먼저, 나머지는 리스트가 먼저
let isEmpty xs =
    match xs with
    | [] -> true
    | _ -> false

let head xs =
    match xs with
    | x :: _ -> x
    | [] -> failwith "head: empty list"

let tail xs =
    match xs with
    | _ :: rest -> rest
    | [] -> failwith "tail: empty list"

// 0 부터 셈. 범위 밖이면 리스트 길이와 함께 Failure
let nth xs (i: int) =
    let outOfRange () = failwith ("nth: index out of range (length " + toString (length xs) + ", index " + toString i + ")")
    let rec go ys k =
        match ys with
        | [] -> outOfRange ()
        | y :: rest -> if k = 0 then y else go rest (k - 1)
    if i < 0 then outOfRange () else go xs i

let rec fold f acc xs =
    match xs with
    | [] -> acc
    | x :: rest -> fold f (f acc x) rest

// reverse, append, map, filter 는 fold 에 함수를 넘기지 않고 직접 재귀: 원소마다 함수 값을 부르지 않음
let reverse xs =
    let rec go xs acc =
        match xs with
        | [] -> acc
        | x :: rest -> go rest (x :: acc)
    go xs []

// xs 를 거꾸로 한 뒤 하나씩 ys 앞에 붙임
let append xs ys =
    let rec go xs acc =
        match xs with
        | [] -> acc
        | x :: rest -> go rest (x :: acc)
    go (reverse xs) ys

let range (a: int) (b: int) : int list =
    let rec go i acc = if i < a then acc else go (i - 1) (i :: acc)
    go b []

// + 는 int 와 string 을 받으므로 표기로 int 를 정함
let sum (xs: int list) : int = fold (fun acc x -> acc + x) 0 xs

// f 는 앞 원소부터 호출 (출력 순서가 F# List.map 과 같음)
let map f xs =
    let rec go xs acc =
        match xs with
        | [] -> reverse acc
        | x :: rest -> go rest (f x :: acc)
    go xs []

let filter f xs =
    let rec go xs acc =
        match xs with
        | [] -> reverse acc
        | x :: rest -> go rest (if f x then x :: acc else acc)
    go xs []

// 결과가 정해지면 나머지 원소에는 f 를 호출하지 않음
let rec exists f xs =
    match xs with
    | [] -> false
    | x :: rest -> if f x then true else exists f rest

let rec forall f xs =
    match xs with
    | [] -> true
    | x :: rest -> if f x then forall f rest else false

// mutable reference (OCaml, F# 와 같음)
let incr (r: int ref) = r := !r + 1
let decr (r: int ref) = r := !r - 1

// option
let tryHead xs =
    match xs with
    | [] -> None
    | x :: _ -> Some x

let rec tryFind f xs =
    match xs with
    | [] -> None
    | x :: rest -> if f x then Some x else tryFind f rest

let defaultValue d opt =
    match opt with
    | Some v -> v
    | None -> d

// 배열 (F# Array 모듈과 같은 이름). length, create, ofList, toList 와 a.[i], a.[i] <- v 는 내장 함수.
// 안의 map, fold 는 위의 리스트 함수 (모듈의 같은 이름은 그 정의 뒤부터 보임)
module Array =
    let init (n: int) f = Array.ofList (map f (range 0 (n - 1)))
    let copy a = Array.ofList (Array.toList a)
    let iter f a =
        for i = 0 to Array.length a - 1 do
            f a.[i]
    let fold f acc a = fold f acc (Array.toList a)
    let map f a = Array.ofList (map f (Array.toList a))
