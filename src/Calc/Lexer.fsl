{
open FSharp.Text.Lexing
open Parser

let lexeme (lexbuf: LexBuffer<_>) = LexBuffer<_>.LexemeString lexbuf

open System.Text
open Errors

/// $"..." 의 구멍 {e} 안의 식을 파싱. 위치는 바깥 입력에서 이어지도록 구멍의 시작 위치부터 셈 (오류가 원래 줄과 열을 가리킴)
let parseHole (tokenize: LexBuffer<char> -> token) (source: string) (start: Position) : Ast.Expr =
    if source.Trim() = "" then syntaxError "Empty expression in interpolated string" start
    let lexbuf = LexBuffer<char>.FromString source
    lexbuf.EndPos <- start
    try
        Parser.start tokenize lexbuf
    with ParseFailure ->
        let tokenStart = lexbuf.StartPos.AbsoluteOffset - start.AbsoluteOffset
        let tokenEnd = lexbuf.EndPos.AbsoluteOffset - start.AbsoluteOffset
        if tokenStart >= tokenEnd then syntaxError "parse error: unexpected end of interpolated expression" lexbuf.StartPos
        else syntaxError (sprintf "parse error: unexpected '%s'" (source.Substring(tokenStart, tokenEnd - tokenStart))) lexbuf.StartPos
}

let digit = ['0'-'9']
let letter = ['a'-'z' 'A'-'Z']
// 소문자나 _ 로 시작하면 변수, 대문자로 시작하면 생성자 (OCaml 과 같은 구분)
let ident_start = ['a'-'z'] | '_'
let ctor_start = ['A'-'Z']
let ident_char = letter | digit | '_'
let whitespace = [' ' '\t']
let newline = ('\n' | '\r' '\n')

rule tokenize = parse
    | whitespace    { tokenize lexbuf }
    | newline       { lexbuf.EndPos <- lexbuf.EndPos.NextLine; tokenize lexbuf }
    // 주석: // 줄 끝까지 (F#), (* ... *) 중첩 가능 (OCaml, F#)
    | "//" [^ '\n' '\r']*
                    { tokenize lexbuf }
    | "(*"          { comment 1 lexbuf.StartPos lexbuf; tokenize lexbuf }
    | digit+        { match System.Int32.TryParse(lexeme lexbuf, System.Globalization.NumberStyles.None,
                                              System.Globalization.CultureInfo.InvariantCulture) with
                      | true, n -> NUMBER n
                      | false, _ -> syntaxError (sprintf "Integer literal out of range: %s" (lexeme lexbuf)) lexbuf.StartPos }
    // 닫히지 않은 문자열 오류는 여는 " 위치로 알려야 하므로 시작 위치를 넘김
    | '"'           { readString (StringBuilder()) lexbuf.StartPos lexbuf }
    // 보간 문자열 $"a{x}b" (F# 와 같음)
    | '$' '"'       { readInterpolated (StringBuilder()) [] lexbuf.StartPos lexbuf }
    // 키워드는 IDENT 보다 먼저 와야 함 (같은 길이로 매치되면 앞의 규칙이 이김)
    | "let"         { LET }
    | "in"          { IN }
    | "rec"         { REC }
    | "function"    { FUNCTION }
    | "fun"         { FUN }
    | "and"         { ANDKW }
    | "if"          { IF }
    | "then"        { THEN }
    | "else"        { ELSE }
    | "true"        { TRUE }
    | "false"       { FALSE }
    | "not"         { NOT }
    | "match"       { MATCH }
    | "try"         { TRY }
    | "exception"   { EXCEPTION }
    | "with"        { WITH }
    | "when"        { WHEN }
    | "type"        { TYPE }
    | "of"          { OF }
    | "module"      { MODULE }
    | "struct"      { STRUCT }
    | "end"         { END }
    | "open"        { OPEN }
    | "while"       { WHILE }
    | "for"         { FOR }
    | "to"          { TO }
    | "downto"      { DOWNTO }
    | "do"          { DO }
    | "done"        { DONE }
    // _ 하나만 와일드카드. _a 처럼 더 길게 일치하면 IDENT (가장 긴 일치)
    | '_'           { UNDERSCORE }
    // 모듈 이름으로 한정한 이름: M.f, M.N.g (값, 타입) 와 M.C (생성자). 점 앞뒤에 공백이 없어야 함
    | (ctor_start ident_char* '.')+ ident_start ident_char*
                    { QIDENT (lexeme lexbuf) }
    | (ctor_start ident_char* '.')+ ctor_start ident_char*
                    { QCTOR (lexeme lexbuf) }
    | ident_start ident_char*
                    { IDENT (lexeme lexbuf) }
    | ctor_start ident_char*
                    { CTOR (lexeme lexbuf) }
    // 타입 변수 'a. 이 언어에는 문자 리터럴이 없으므로 ' 는 여기서만 쓰임
    | '\'' ident_start ident_char*
                    { TYVAR ((lexeme lexbuf).Substring 1) }
    | "->"          { ARROW }
    | "<>"          { NOTEQUAL }
    | "|>"          { PIPE }
    | ">>"          { COMPOSE }
    | "<="          { LESSEQUAL }
    | ">="          { GREATEREQUAL }
    | '<'           { LESS }
    | '>'           { GREATER }
    | '='           { EQUALS }
    | "&&"          { AND }
    | "||"          { OR }
    | "::"          { CONS }
    | ":="          { COLONEQUALS }
    | ':'           { COLON }
    | '|'           { BAR }
    // 레코드
    | '{'           { LBRACE }
    | '}'           { RBRACE }
    | '.'           { DOT }
    // 배열 [| … |], a.[i] <- v
    | "[|"          { LBRACKBAR }
    | "|]"          { BARRBRACK }
    | "<-"          { LARROW }
    | '['           { LBRACKET }
    | ']'           { RBRACKET }
    | ";;"          { SEMISEMI }
    | ';'           { SEMI }
    | '!'           { BANG }
    | ','           { COMMA }
    | '+'           { PLUS }
    | '-'           { MINUS }
    | '*'           { STAR }
    | '/'           { SLASH }
    | '%'           { PERCENT }
    | '('           { LPAREN }
    | ')'           { RPAREN }
    | eof           { EOF }
    | _             { syntaxError (sprintf "Unexpected character: %s" (lexeme lexbuf)) lexbuf.StartPos }

// 여는 " 다음부터 닫는 " 까지 읽어서 STRING 토큰 하나를 만듦
and readString (sb: StringBuilder) (start: Position) = parse
    // 토큰 위치가 닫는 " 가 아니라 여는 " 부터가 되도록 StartPos 를 되돌림
    | '"'           { lexbuf.StartPos <- start; STRING (sb.ToString()) }
    // 액션 코드에서 '"' 라고 쓰면 fslex 가 " 를 문자열 시작으로 보고 "unterminated string in code" 오류를 냄
    | '\\' '"'      { sb.Append('\"') |> ignore; readString sb start lexbuf }
    | '\\' '\\'     { sb.Append('\\') |> ignore; readString sb start lexbuf }
    | '\\' 'n'      { sb.Append('\n') |> ignore; readString sb start lexbuf }
    | '\\' 't'      { sb.Append('\t') |> ignore; readString sb start lexbuf }
    | '\\' 'r'      { sb.Append('\r') |> ignore; readString sb start lexbuf }
    | '\\' _        { syntaxError (sprintf "Invalid escape sequence: %s" (lexeme lexbuf)) lexbuf.StartPos }
    | newline       { lexbuf.EndPos <- lexbuf.EndPos.NextLine; sb.Append(lexeme lexbuf) |> ignore; readString sb start lexbuf }
    | eof           { syntaxError "Unterminated string" start }
    | _             { sb.Append(lexeme lexbuf) |> ignore; readString sb start lexbuf }

// $" 다음부터 닫는 " 까지. 글자는 포맷 문자열로 모으고(% 는 %%), 구멍(중괄호 안의 식)은 %A 자리,
// 앞에 %d 처럼 지정자를 붙이면 그 지정자 자리. 중괄호를 두 번 쓰면 중괄호 글자 (F# 와 같음). holes 는 거꾸로 모은 구멍의 식.
// (fslex 는 규칙 인자의 타입 표기로 이름 하나만 받음: Ast.Expr list 나 list<_> 는 parse error 라서 holes 는 표기하지 않음)
and readInterpolated (sb: StringBuilder) holes (start: Position) = parse
    | '"'           { lexbuf.StartPos <- start; INTERP (sb.ToString(), List.rev holes) }
    | '\\' '"'      { sb.Append('\"') |> ignore; readInterpolated sb holes start lexbuf }
    | '\\' '\\'     { sb.Append('\\') |> ignore; readInterpolated sb holes start lexbuf }
    | '\\' 'n'      { sb.Append('\n') |> ignore; readInterpolated sb holes start lexbuf }
    | '\\' 't'      { sb.Append('\t') |> ignore; readInterpolated sb holes start lexbuf }
    | '\\' 'r'      { sb.Append('\r') |> ignore; readInterpolated sb holes start lexbuf }
    | '\\' _        { syntaxError (sprintf "Invalid escape sequence: %s" (lexeme lexbuf)) lexbuf.StartPos }
    // 액션 코드의 중괄호 문자 리터럴은 fslex 가 코드의 중괄호로 세므로 문자열로 씀
    | "{{"          { sb.Append("{") |> ignore; readInterpolated sb holes start lexbuf }
    | "}}"          { sb.Append("}") |> ignore; readInterpolated sb holes start lexbuf }
    | '}'           { syntaxError "Unmatched } in interpolated string (use }} for a brace)" lexbuf.StartPos }
    | '%' ['d' 's' 'b' 'A'] '{'
                    { let spec = (lexeme lexbuf).Substring(0, 2)
                      let holeStart = lexbuf.EndPos
                      let source = interpolationHole (StringBuilder()) 0 start lexbuf
                      sb.Append(spec) |> ignore
                      readInterpolated sb (parseHole tokenize source holeStart :: holes) start lexbuf }
    | '{'           { let holeStart = lexbuf.EndPos
                      let source = interpolationHole (StringBuilder()) 0 start lexbuf
                      sb.Append("%A") |> ignore
                      readInterpolated sb (parseHole tokenize source holeStart :: holes) start lexbuf }
    | '%'           { sb.Append("%%") |> ignore; readInterpolated sb holes start lexbuf }
    | newline       { lexbuf.EndPos <- lexbuf.EndPos.NextLine; sb.Append(lexeme lexbuf) |> ignore; readInterpolated sb holes start lexbuf }
    | eof           { syntaxError "Unterminated string" start }
    | _             { sb.Append(lexeme lexbuf) |> ignore; readInterpolated sb holes start lexbuf }

// 보간 문자열의 구멍: 여는 중괄호 다음부터 짝이 맞는 닫는 중괄호까지의 소스 (닫는 것은 빼고). 안의 문자열 리터럴 속 중괄호는 세지 않음
and interpolationHole (source: StringBuilder) (depth: int) (start: Position) = parse
    | '}'           { if depth = 0 then source.ToString()
                      else (source.Append(lexeme lexbuf) |> ignore; interpolationHole source (depth - 1) start lexbuf) }
    | '{'           { source.Append(lexeme lexbuf) |> ignore; interpolationHole source (depth + 1) start lexbuf }
    | '"' ([^ '"' '\\' '\n' '\r'] | '\\' _)* '"'
                    { source.Append(lexeme lexbuf) |> ignore; interpolationHole source depth start lexbuf }
    | newline       { lexbuf.EndPos <- lexbuf.EndPos.NextLine; source.Append(lexeme lexbuf) |> ignore; interpolationHole source depth start lexbuf }
    | eof           { syntaxError "Unterminated string" start }
    | _             { source.Append(lexeme lexbuf) |> ignore; interpolationHole source depth start lexbuf }

// (* 다음부터 짝이 맞는 *) 까지 건너뜀. depth 는 열린 주석 수
and comment (depth: int) (start: Position) = parse
    | "(*"          { comment (depth + 1) start lexbuf }
    | "*)"          { if depth > 1 then comment (depth - 1) start lexbuf }
    | newline       { lexbuf.EndPos <- lexbuf.EndPos.NextLine; comment depth start lexbuf }
    | eof           { syntaxError "Unterminated comment" start }
    | _             { comment depth start lexbuf }
