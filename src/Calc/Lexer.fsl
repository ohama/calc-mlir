{
open FSharp.Text.Lexing
open Parser

let lexeme (lexbuf: LexBuffer<_>) = LexBuffer<_>.LexemeString lexbuf

open System.Text
}

let digit = ['0'-'9']
let letter = ['a'-'z' 'A'-'Z']
let ident_start = letter | '_'
let ident_char = letter | digit | '_'
let whitespace = [' ' '\t']
let newline = ('\n' | '\r' '\n')

rule tokenize = parse
    | whitespace    { tokenize lexbuf }
    | newline       { lexbuf.EndPos <- lexbuf.EndPos.NextLine; tokenize lexbuf }
    | digit+        { NUMBER (int (lexeme lexbuf)) }
    | '"'           { readString (StringBuilder()) lexbuf }
    // 키워드는 IDENT 보다 먼저 와야 함 (같은 길이로 매치되면 앞의 규칙이 이김)
    | "let"         { LET }
    | "in"          { IN }
    | "rec"         { REC }
    | "fun"         { FUN }
    | "if"          { IF }
    | "then"        { THEN }
    | "else"        { ELSE }
    | "true"        { TRUE }
    | "false"       { FALSE }
    | "not"         { NOT }
    | "match"       { MATCH }
    | "with"        { WITH }
    | ident_start ident_char*
                    { IDENT (lexeme lexbuf) }
    | "->"          { ARROW }
    | "<>"          { NOTEQUAL }
    | "<="          { LESSEQUAL }
    | ">="          { GREATEREQUAL }
    | '<'           { LESS }
    | '>'           { GREATER }
    | '='           { EQUALS }
    | "&&"          { AND }
    | "||"          { OR }
    | "::"          { CONS }
    | '|'           { BAR }
    | '['           { LBRACKET }
    | ']'           { RBRACKET }
    | ';'           { SEMI }
    | '+'           { PLUS }
    | '-'           { MINUS }
    | '*'           { STAR }
    | '/'           { SLASH }
    | '('           { LPAREN }
    | ')'           { RPAREN }
    | eof           { EOF }
    | _             { failwithf "Unexpected character: %s" (lexeme lexbuf) }

// 여는 " 다음부터 닫는 " 까지 읽어서 STRING 토큰 하나를 만듦
and readString (sb: StringBuilder) = parse
    | '"'           { STRING (sb.ToString()) }
    // 액션 코드에서 '"' 라고 쓰면 fslex 가 " 를 문자열 시작으로 보고 "unterminated string in code" 오류를 냄
    | '\\' '"'      { sb.Append('\"') |> ignore; readString sb lexbuf }
    | '\\' '\\'     { sb.Append('\\') |> ignore; readString sb lexbuf }
    | '\\' 'n'      { sb.Append('\n') |> ignore; readString sb lexbuf }
    | '\\' 't'      { sb.Append('\t') |> ignore; readString sb lexbuf }
    | '\\' 'r'      { sb.Append('\r') |> ignore; readString sb lexbuf }
    | '\\' _        { failwithf "Invalid escape sequence: %s" (lexeme lexbuf) }
    | newline       { lexbuf.EndPos <- lexbuf.EndPos.NextLine; sb.Append(lexeme lexbuf) |> ignore; readString sb lexbuf }
    | eof           { failwith "Unterminated string" }
    | _             { sb.Append(lexeme lexbuf) |> ignore; readString sb lexbuf }
