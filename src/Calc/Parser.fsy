%{
open Ast

/// 기본 동작은 위치 없는 Exception "parse error". Program.parse 가 lexbuf 의 위치를 붙이도록 따로 구분되는 예외를 던짐
let parse_error_rich = Some (fun (_: FSharp.Text.Parsing.ParseErrorContext<_>) -> raise Errors.ParseFailure)

/// 만든 노드에 이 규칙의 시작 위치(첫 기호의 시작)를 기록 (Errors.positionOf 로 찾음). 타입 오류와 경고의 위치.
/// ResultRange 의 시작은 첫 토큰이 아니라 그다음 기호를 가리킬 때가 있어서 InputStartPosition 1 을 씀
let at (parseState: FSharp.Text.Parsing.IParseState) (node: 'a) : 'a =
    Errors.recordPosition (box node) (parseState.InputStartPosition 1)
    node

/// 매개변수 () 는 이름 "()" 로 받고 본문에서 unit 패턴으로 확인: fun () -> e  ==  fun "()" -> match "()" with () -> e
/// (타입이 unit 으로 정해짐. "()" 는 렉서가 만들 수 없는 이름이라 사용자 이름과 겹치지 않음).
/// 타입을 적은 매개변수 (x: t) 는 본문 앞에서 다시 묶음: fun (x: t) -> e  ==  fun x -> let x = (x : t) in e
let paramBody (param: string, annot: Expr option) (body: Expr) =
    match annot with
    | Some a -> Let(param, a, body)
    | None when param = "()" -> Match(Var "()", [ PUnit, None, body ])
    | None -> body

/// fun x y -> body  ==  fun x -> fun y -> body
let makeLambda (parameters: (string * Expr option) list) (body: Expr) =
    List.foldBack (fun (p, a) acc -> Lambda(p, paramBody (p, a) acc)) parameters body

/// let rec f x y = body 의 (f 의 매개변수, 본문)
let recFunction (parameters: (string * Expr option) list) (body: Expr) =
    let first = List.head parameters
    fst first, paramBody first (makeLambda (List.tail parameters) body)

/// 반환 타입 표기: let f x : t = e  ==  let f x = (e : t). 위치는 타입의 시작 (경고가 가리킴)
let annotate (annot: (TypeExpr * FSharp.Text.Lexing.Position) option) (e: Expr) =
    match annot with
    | Some (t, pos) ->
        let node = Annot(e, t)
        Errors.recordPosition (box node) pos
        node
    | None -> e

/// let rec ... and ...: 같은 이름을 두 번 정의하면 오류
let checkRecBindings (pos: FSharp.Text.Lexing.Position) (bindings: (string * string * Expr) list) =
    match bindings |> List.countBy (fun (name, _, _) -> name) |> List.tryFind (fun (_, n) -> n > 1) with
    | Some (name, _) -> Errors.syntaxError (sprintf "Variable %s is bound several times in this let rec" name) pos
    | None -> bindings

/// x |> f  ==  let $pipe = x in f $pipe (F# 처럼 x 를 먼저 계산)
let makePipe (x: Expr) (f: Expr) = Let("$pipe", x, App(f, Var "$pipe"))

/// f >> g  ==  let $f = f in let $g = g in fun $x -> $g ($f $x)
let makeCompose (f: Expr) (g: Expr) =
    Let("$f", f, Let("$g", g, Lambda("$x", App(Var "$g", App(Var "$f", Var "$x")))))

/// while c do body done  ==  let rec $while $u = if c then (body; $while ()) else () in $while ()
/// (tail recursion 이라 인터프리터와 컴파일러 모두 스택이 자라지 않음. body 가 unit 이 아니면 e1; e2 와 같은 경고)
let makeWhile (cond: Expr) (body: Expr) =
    LetRec("$while", "$u", If(cond, Seq(body, App(Var "$while", Unit)), Unit), App(Var "$while", Unit))

/// for i = a to b do body done  ==
///   let $start = (a : int) in let $stop = (b : int) in
///   let rec $for i = body; if i < $stop then $for (i + 1) else () in
///   if $start <= $stop then $for $start else ()
/// a, b 는 한 번씩 a 부터 계산 (OCaml 과 같음). 끝에 닿으면 i + 1 을 계산하지 않으므로 b 가 int 의 최댓값이어도 끝남.
/// downto 는 비교와 증감이 반대
let makeFor (var: string) (start: Expr) (up: bool) (stop: Expr) (body: Expr) =
    let tInt = TName("int", [])
    let before, step = if up then Less, Add else Greater, Subtract
    let startsBefore = if up then LessEqual(Var "$start", Var "$stop") else GreaterEqual(Var "$start", Var "$stop")
    let next = If(before(Var var, Var "$stop"), App(Var "$for", step(Var var, Number 1)), Unit)
    Let("$start", Annot(start, tInt),
        Let("$stop", Annot(stop, tInt),
            LetRec("$for", var, Seq(body, next), If(startsBefore, App(Var "$for", Var "$start"), Unit))))

/// 최상위 항목들을 식 하나로: 선언은 뒤 항목 전체를 본문으로 하는 let, 식은 e; (나머지). 끝이 선언이면 ()
let rec makeProgram (items: TopItem list) : Expr =
    let located (pos: FSharp.Text.Lexing.Position) (e: Expr) =
        Errors.recordPosition (box e) pos
        e
    match items with
    | [] -> Unit
    | [ TopExpr e ] -> e
    | TopExpr e :: rest -> Seq(e, makeProgram rest)
    | TopLet (name, value, pos) :: rest -> located pos (Let(name, value, makeProgram rest))
    | TopLetRec (name, param, body, pos) :: rest -> located pos (LetRec(name, param, body, makeProgram rest))
    | TopLetRecs (bindings, pos) :: rest -> located pos (LetRecs(bindings, makeProgram rest))
    | TopLetPattern (pattern, value, pos) :: rest -> located pos (LetPattern(pattern, value, makeProgram rest))
    | TopType (name, typeParams, ctors, pos) :: rest -> located pos (TypeDecl(name, typeParams, ctors, makeProgram rest))
    | TopRecord (name, typeParams, fields, pos) :: rest -> located pos (RecordDecl(name, typeParams, fields, makeProgram rest))
    | TopException (name, argType, pos) :: rest -> located pos (ExceptionDecl(name, argType, makeProgram rest))
    | (TopModule _ | TopOpen _) :: _ -> failwith "makeProgram: modules are resolved by Modules.resolveProgram"

/// [a; b; c]  ==  a :: b :: c :: []
/// 안쪽 cons 에는 그 원소의 위치를 기록: [1; true] 의 오류가 true 를 가리키도록
let makeList (items: Expr list) =
    List.foldBack (fun item acc -> Errors.copyPosition (box item) (box (Cons(item, acc))) :?> Expr) items Nil

/// 패턴 [a; b]  ==  a :: b :: []
let makeListPattern (items: Pattern list) =
    List.foldBack (fun item acc -> PCons(item, acc)) items PNil

let rec patternVars pattern =
    match pattern with
    | PVar name -> [ name ]
    | PCons (h, t) -> patternVars h @ patternVars t
    | PTuple items -> List.collect patternVars items
    | PCtor (_, Some p) -> patternVars p
    | PCtor (_, None) -> []
    | PWildcard | PInt _ | PBool _ | PString _ | PNil | PUnit -> []
    // 두 쪽이 같은 이름을 묶음 (checkPattern 이 확인)
    | POr (a, _) -> patternVars a

/// p1 | p2 의 두 쪽은 같은 이름을 묶어야 함 (OCaml 과 같은 규칙)
let rec checkOrPatterns (pos: FSharp.Text.Lexing.Position) pattern =
    match pattern with
    | POr (a, b) ->
        checkOrPatterns pos a
        checkOrPatterns pos b
        let left, right = Set.ofList (patternVars a), Set.ofList (patternVars b)
        match Set.toList (Set.union (Set.difference left right) (Set.difference right left)) with
        | name :: _ -> Errors.syntaxError (sprintf "Variable %s must occur on both sides of this | pattern" name) pos
        | [] -> ()
    | PCons (h, t) ->
        checkOrPatterns pos h
        checkOrPatterns pos t
    | PTuple items -> List.iter (checkOrPatterns pos) items
    | PCtor (_, Some p) -> checkOrPatterns pos p
    | _ -> ()

/// 한 패턴 안에서 같은 이름을 두 번 묶으면 오류 (F# 와 같음). pos 는 패턴의 시작 위치
let checkPattern (pos: FSharp.Text.Lexing.Position) pattern =
    checkOrPatterns pos pattern
    let names = patternVars pattern
    match names |> List.countBy id |> List.tryFind (fun (_, n) -> n > 1) with
    | Some (name, _) -> Errors.syntaxError (sprintf "Duplicate variable in pattern: %s" name) pos
    | None -> pattern

/// 한 type 선언 안에서 같은 생성자 이름을 두 번 쓰면 오류
let checkCtors (pos: FSharp.Text.Lexing.Position) (ctors: (string * TypeExpr option) list) =
    match ctors |> List.countBy fst |> List.tryFind (fun (_, n) -> n > 1) with
    | Some (name, _) -> Errors.syntaxError (sprintf "Duplicate constructor: %s" name) pos
    | None -> ctors

/// 레코드 선언과 레코드 식에서 같은 필드를 두 번 쓰면 오류. pos 는 여는 { 의 위치
let checkFields (pos: FSharp.Text.Lexing.Position) (fields: (string * 'a) list) =
    match fields |> List.countBy fst |> List.tryFind (fun (_, n) -> n > 1) with
    | Some (name, _) -> Errors.syntaxError (sprintf "Duplicate field: %s" name) pos
    | None -> fields

/// t1 * t2 * t3 는 TTuple [t1; t2; t3]. 괄호로 묶은 (t1 * t2) 는 원소 하나로 남음
let makeTuple (items: TypeExpr list) =
    match items with
    | [ t ] -> t
    | ts -> TTuple ts
%}

%token <int> NUMBER
%token <string> IDENT
%token <string> CTOR TYVAR
%token <string> STRING
/// $"..." 보간: (포맷 문자열, 구멍의 식들). 포맷의 %A, %d 같은 자리마다 식 하나
%token <string * Ast.Expr list> INTERP
%token LET REC IN EQUALS FUN FUNCTION ANDKW ARROW
%token IF THEN ELSE TRUE FALSE
%token NOTEQUAL LESS GREATER LESSEQUAL GREATEREQUAL
%token AND OR NOT
%token MATCH TRY WITH WHEN BAR CONS LBRACKET RBRACKET SEMI SEMISEMI
%token COMMA UNDERSCORE
%token TYPE OF COLON EXCEPTION
%token WHILE FOR TO DOWNTO DO DONE BANG COLONEQUALS
%token LBRACE RBRACE DOT
/// M.f, M.t 와 M.C (모듈 이름으로 한정한 이름)
%token <string> QIDENT QCTOR
%token MODULE STRUCT END OPEN
%token NOBAR BELOWSEMI
%token PLUS MINUS STAR SLASH PERCENT PIPE COMPOSE LPAREN RPAREN
%token EOF

// 아래로 갈수록 우선순위가 높음.
// IN, ELSE, ARROW 가 가장 낮으므로 let 본문, else 분기, fun 본문은 오른쪽으로 최대한 길게 이어짐:
//   let x = 1 in x + 2           ==  let x = 1 in (x + 2)
//   if c then 1 else 2 + 3       ==  if c then 1 else (2 + 3)
//   fun x -> x + 1               ==  fun x -> (x + 1)
// match 의 마지막 분기 본문도 ARROW 가 가장 낮으므로 오른쪽으로 최대한 길게 이어짐.
// :: 는 오른쪽 결합이고 비교보다 강하고 + - 보다 약함 (F# 와 같음):
//   1 + 2 :: xs  ==  (1 + 2) :: xs,   1 :: 2 :: []  ==  1 :: (2 :: [])
// 비교 연산자는 왼쪽 결합: 1 < 2 < 3 == (1 < 2) < 3 → 평가 시 타입 오류.
// (fsyacc 는 %nonassoc 연산자가 연달아 나와도 오류로 만들지 않고 shift/reduce 충돌을 보고하므로 %left 사용)
// 함수 호출(f x)은 우선순위 선언이 아니라 AppExpr/Atom 계층으로 가장 강하게 묶임.
// match 분기 목록을 끝내는 규칙(Arms: Arm)은 BAR 보다 약함 → 중첩 match 의 뒤 분기는 안쪽 match 것 (F# 와 같음)
// SeqExpr: Expr 규칙이 가장 약함 → e1; e2 와 이항 연산자는 항상 이어짐 (let 본문은 ; 까지 포함, OCaml 과 같음).
// 리스트 [a; b] 의 ; 는 SeqExpr 를 쓰지 않으므로 구분자로 남음
%nonassoc BELOWSEMI
%nonassoc SEMI
%nonassoc NOBAR
%nonassoc BAR
%nonassoc IN ELSE ARROW
// r := e 는 이항 연산자 가운데 가장 약하고 오른쪽 결합 (OCaml 과 같음): r := !r + 1  ==  r := (!r + 1)
%right COLONEQUALS
%left OR
%left AND
// |> 와 >> 는 비교와 같은 자리 (F#, OCaml 과 같음): x + 1 |> f == f (x + 1), xs |> map f |> sum 은 왼쪽부터
%left EQUALS NOTEQUAL LESS GREATER LESSEQUAL GREATEREQUAL PIPE COMPOSE
%right CONS
%left PLUS MINUS
%left STAR SLASH PERCENT
%nonassoc UMINUS NOT

%start start startItems
%type <Ast.Expr> start
%type <Ast.TopItem list> startItems

%%

start:
    | Items EOF                     { makeProgram (Modules.resolveProgram $1) }

// REPL: 입력 하나의 항목들을 그대로 (선언마다 환경에 더함)
startItems:
    | Items EOF                     { $1 }

// 프로그램 = 최상위 항목들. 선언(in 없는 let, let rec, type)은 차례로 쓰고, 선언 뒤의 식은 ;; 다음에 씀 (OCaml 과 같음).
// 식 하나만 있는 프로그램은 예전과 같은 AST
Items:
    |                               { [] }
    | SEMISEMI Items                { $2 }
    | SeqExpr                       { [ TopExpr $1 ] }
    | SeqExpr SEMISEMI Items        { TopExpr $1 :: $3 }
    | TopDecl AfterDecl             { $1 :: $2 }

// 선언 바로 뒤에는 식이 올 수 없음 (let x = f 다음 줄의 g 가 f g 인지 알 수 없으므로)
AfterDecl:
    |                               { [] }
    | SEMISEMI Items                { $2 }
    | TopDecl AfterDecl             { $1 :: $2 }

TopDecl:
    | LET IDENT OptAnnot EQUALS SeqExpr
                                    { TopLet($2, annotate $3 $5, parseState.InputStartPosition 1) }
    | LET IDENT Params OptAnnot EQUALS SeqExpr
                                    { TopLet($2, makeLambda $3 (annotate $4 $6), parseState.InputStartPosition 1) }
    | LET LetPattern EQUALS SeqExpr { TopLetPattern($2, $4, parseState.InputStartPosition 1) }
    | LET REC IDENT Params OptAnnot EQUALS SeqExpr
                                    { let param, body = recFunction $4 (annotate $5 $7) in TopLetRec($3, param, body, parseState.InputStartPosition 1) }
    | LET REC RecBinding ANDKW RecBindings
                                    { TopLetRecs(checkRecBindings (parseState.InputStartPosition 1) ($3 :: $5), parseState.InputStartPosition 1) }
    | TYPE TypeParams TypeName EQUALS OptBar CtorDecls
                                    { TopType($3, $2, checkCtors (parseState.InputStartPosition 6) $6, parseState.InputStartPosition 1) }
    | TYPE TypeParams TypeName EQUALS LBRACE FieldDecls RBRACE
                                    { TopRecord($3, $2, checkFields (parseState.InputStartPosition 5) $6, parseState.InputStartPosition 1) }
    | EXCEPTION CtorDecl            { TopException(fst $2, snd $2, parseState.InputStartPosition 1) }
    // 모듈 (OCaml 과 같음). 안에는 선언만 (식은 let _ = e)
    | MODULE CTOR EQUALS STRUCT ModuleItems END
                                    { TopModule($2, $5, parseState.InputStartPosition 1) }
    | OPEN CTOR                     { TopOpen($2, parseState.InputStartPosition 2) }
    | OPEN QCTOR                    { TopOpen($2, parseState.InputStartPosition 2) }

ModuleItems:
    |                               { [] }
    | SEMISEMI ModuleItems          { $2 }
    | TopDecl ModuleItems           { $1 :: $2 }

// let 의 왼쪽에 오는 패턴: 튜플, (), _
LetPattern:
    | TuplePattern                  { checkPattern (parseState.InputStartPosition 1) $1 }
    | LPAREN RPAREN                 { PUnit }
    | UNDERSCORE                    { PWildcard }

// e1; e2; e3 == e1; (e2; e3). let 본문, fun 본문, match 분기, 괄호 안, 최상위에서 씀
SeqExpr:
    | Expr %prec BELOWSEMI          { $1 }
    | Expr SEMI SeqExpr             { at parseState (Seq($1, $3)) }

Expr:
    | AppExpr                       { $1 }
    | LET IDENT OptAnnot EQUALS SeqExpr IN SeqExpr
                                    { at parseState (Let($2, annotate $3 $5, $7)) }
    | LET IDENT Params OptAnnot EQUALS SeqExpr IN SeqExpr
                                    { at parseState (Let($2, makeLambda $3 (annotate $4 $6), $8)) }
    | LET LetPattern EQUALS SeqExpr IN SeqExpr
                                    { at parseState (LetPattern($2, $4, $6)) }
    | TYPE TypeParams TypeName EQUALS OptBar CtorDecls IN SeqExpr
                                    { at parseState (TypeDecl($3, $2, checkCtors (parseState.InputStartPosition 6) $6, $8)) }
    | TYPE TypeParams TypeName EQUALS LBRACE FieldDecls RBRACE IN SeqExpr
                                    { at parseState (RecordDecl($3, $2, checkFields (parseState.InputStartPosition 5) $6, $9)) }
    | LET REC IDENT Params OptAnnot EQUALS SeqExpr IN SeqExpr
                                    { let param, body = recFunction $4 (annotate $5 $7) in at parseState (LetRec($3, param, body, $9)) }
    | LET REC RecBinding ANDKW RecBindings IN SeqExpr
                                    { at parseState (LetRecs(checkRecBindings (parseState.InputStartPosition 1) ($3 :: $5), $7)) }
    | FUNCTION OptBar Arms          { at parseState (Lambda("$function", at parseState (Match(Var "$function", $3)))) }
    | FUN Params ARROW SeqExpr      { at parseState (makeLambda $2 $4) }
    | IF Expr THEN Expr ELSE Expr   { at parseState (If($2, $4, $6)) }
    | MATCH Expr WITH OptBar Arms   { at parseState (Match($2, $5)) }
    | TRY SeqExpr WITH OptBar Arms  { at parseState (Try($2, $5)) }
    | EXCEPTION CtorDecl IN SeqExpr { at parseState (ExceptionDecl(fst $2, snd $2, $4)) }
    | WHILE SeqExpr DO SeqExpr DONE { at parseState (makeWhile $2 $4) }
    | FOR IDENT EQUALS SeqExpr TO SeqExpr DO SeqExpr DONE
                                    { at parseState (makeFor $2 $4 true $6 $8) }
    | FOR IDENT EQUALS SeqExpr DOWNTO SeqExpr DO SeqExpr DONE
                                    { at parseState (makeFor $2 $4 false $6 $8) }
    // 가변 참조: ref, !, := 는 내장 함수. ! 와 := 는 사용자가 쓸 수 없는 이름이라 가려지지 않음
    | Expr COLONEQUALS Expr         { at parseState (App(App(Var ":=", $1), $3)) }
    | Expr CONS Expr                { at parseState (Cons($1, $3)) }
    | Expr PLUS Expr                { at parseState (Add($1, $3)) }
    | Expr MINUS Expr               { at parseState (Subtract($1, $3)) }
    | Expr STAR Expr                { at parseState (Multiply($1, $3)) }
    | Expr SLASH Expr               { at parseState (Divide($1, $3)) }
    | Expr PERCENT Expr             { at parseState (Modulo($1, $3)) }
    | Expr PIPE Expr                { at parseState (makePipe $1 $3) }
    | Expr COMPOSE Expr             { at parseState (makeCompose $1 $3) }
    | MINUS Expr %prec UMINUS       { at parseState (Negate $2) }
    | Expr EQUALS Expr              { at parseState (Equal($1, $3)) }
    | Expr NOTEQUAL Expr            { at parseState (NotEqual($1, $3)) }
    | Expr LESS Expr                { at parseState (Less($1, $3)) }
    | Expr GREATER Expr             { at parseState (Greater($1, $3)) }
    | Expr LESSEQUAL Expr           { at parseState (LessEqual($1, $3)) }
    | Expr GREATEREQUAL Expr        { at parseState (GreaterEqual($1, $3)) }
    | Expr AND Expr                 { at parseState (And($1, $3)) }
    | Expr OR Expr                  { at parseState (Or($1, $3)) }
    | NOT Expr                      { at parseState (Not $2) }

// 함수 호출: 왼쪽 결합 (f x y == (f x) y)
AppExpr:
    | AppExpr Atom                  { at parseState (App($1, $2)) }
    | Atom                          { $1 }

// !r 은 함수 호출보다 강하고 필드 읽기보다 약함: f !r  ==  f (!r),  !p.x  ==  !(p.x) (OCaml 과 같음)
Atom:
    | Primary                       { $1 }
    | BANG Atom                     { at parseState (App(Var "!", $2)) }

Primary:
    | NUMBER                        { at parseState (Number $1) }
    | TRUE                          { at parseState (Bool true) }
    | FALSE                         { at parseState (Bool false) }
    | STRING                        { at parseState (Str $1) }
    // $"a{x}b{y}" == sprintf "a%Ab%A" x y (Printf 에 구멍의 식을 차례로 적용)
    | INTERP                        { let format, holes = $1 in
                                      at parseState (List.fold (fun f e -> App (f, e)) (at parseState (Printf ("sprintf", format))) holes) }
    | IDENT                         { at parseState (Var $1) }
    // 필드 읽기는 함수 호출보다 강하고 왼쪽 결합: f p.x  ==  f (p.x),  a.b.c  ==  (a.b).c
    | Primary DOT IDENT             { at parseState (Field($1, $3)) }
    | LBRACE RecordFields RBRACE    { at parseState (Record(checkFields (parseState.InputStartPosition 1) $2)) }
    | LBRACE Primary WITH RecordFields RBRACE
                                    { at parseState (RecordUpdate($2, checkFields (parseState.InputStartPosition 1) $4)) }
    | CTOR                          { at parseState (Ctor $1) }
    | QIDENT                        { at parseState (Var $1) }
    | QCTOR                         { at parseState (Ctor $1) }
    | LPAREN RPAREN                 { Unit }
    | LPAREN Expr RPAREN            { $2 }
    | LPAREN Expr COLON TypeExpr RPAREN
                                    { annotate (Some ($4, parseState.InputStartPosition 4)) $2 }
    | LPAREN Expr SEMI SeqExpr RPAREN
                                    { at parseState (Seq($2, $4)) }
    | LPAREN Expr COMMA TupleItems RPAREN
                                    { at parseState (Tuple($2 :: $4)) }
    | LBRACKET RBRACKET             { Nil }
    | LBRACKET ListItems RBRACKET   { at parseState (makeList $2) }

// 레코드 식의 필드: x = e; y = e. 마지막 ; 는 생략 가능 (OCaml, F# 와 같음)
RecordFields:
    | RecordField                   { [ $1 ] }
    | RecordField SEMI              { [ $1 ] }
    | RecordField SEMI RecordFields { $1 :: $3 }

RecordField:
    | IDENT EQUALS Expr             { ($1, $3) }

// 레코드 선언의 필드: x: int; y: int
FieldDecls:
    | FieldDecl                     { [ $1 ] }
    | FieldDecl SEMI                { [ $1 ] }
    | FieldDecl SEMI FieldDecls     { $1 :: $3 }

FieldDecl:
    | IDENT COLON TypeExpr          { ($1, $3) }

ListItems:
    | Expr                          { [ $1 ] }
    | Expr SEMI ListItems           { $1 :: $3 }

TupleItems:
    | Expr                          { [ $1 ] }
    | Expr COMMA TupleItems         { $1 :: $3 }

// 첫 분기 앞의 | 는 생략 가능
OptBar:
    | BAR                           { () }
    |                               { () }

// 분기 목록. 마지막 분기 본문은 ARROW 가 가장 약하므로 오른쪽 끝까지 이어짐
Arms:
    | Arm %prec NOBAR               { [ $1 ] }
    | Arm BAR Arms                  { $1 :: $3 }

// 분기(튜플 객체)에 패턴의 시작 위치를 기록: 쓰이지 않는 분기 경고가 가리킴 (패턴 _ 는 위치를 기록할 수 없음)
Arm:
    | Pattern ARROW SeqExpr         { at parseState (checkPattern (parseState.InputStartPosition 1) $1, None, $3) }
    | Pattern WHEN Expr ARROW SeqExpr
                                    { at parseState (checkPattern (parseState.InputStartPosition 1) $1, Some $3, $5) }

// | 패턴이 가장 약함: A :: xs | [] == (A :: xs) | []
// :: 패턴은 오른쪽 결합 (h :: t :: rest == h :: (t :: rest))
// 생성자 패턴이 :: 보다 강함: Some x :: rest == (Some x) :: rest
Pattern:
    | ConsPattern                   { $1 }
    | ConsPattern BAR Pattern       { at parseState (POr($1, $3)) }

ConsPattern:
    | CtorPattern CONS ConsPattern  { at parseState (PCons($1, $3)) }
    | CtorPattern                   { $1 }

CtorPattern:
    | CTOR AtomPattern              { at parseState (PCtor($1, Some $2)) }
    | QCTOR AtomPattern             { at parseState (PCtor($1, Some $2)) }
    | AtomPattern                   { $1 }

AtomPattern:
    | IDENT                         { at parseState (PVar $1) }
    | UNDERSCORE                    { PWildcard }
    | CTOR                          { at parseState (PCtor($1, None)) }
    | QCTOR                         { at parseState (PCtor($1, None)) }
    | NUMBER                        { at parseState (PInt $1) }
    | MINUS NUMBER                  { at parseState (PInt -$2) }
    | TRUE                          { at parseState (PBool true) }
    | FALSE                         { at parseState (PBool false) }
    | STRING                        { at parseState (PString $1) }
    | LBRACKET RBRACKET             { PNil }
    | LPAREN RPAREN                 { PUnit }
    | LBRACKET PatternItems RBRACKET
                                    { at parseState (makeListPattern $2) }
    | LPAREN Pattern RPAREN         { $2 }
    | TuplePattern                  { $1 }

TuplePattern:
    | LPAREN Pattern COMMA PatternItemsComma RPAREN
                                    { at parseState (PTuple($2 :: $4)) }

PatternItems:
    | Pattern                       { [ $1 ] }
    | Pattern SEMI PatternItems     { $1 :: $3 }

PatternItemsComma:
    | Pattern                       { [ $1 ] }
    | Pattern COMMA PatternItemsComma
                                    { $1 :: $3 }

// type 선언: 'a tree, ('k, 'v) map 처럼 타입 변수는 이름 앞에 씀 (OCaml 방식)
TypeParams:
    |                               { [] }
    | TYVAR                         { [ $1 ] }
    | LPAREN TyvarList RPAREN       { $2 }

TyvarList:
    | TYVAR                         { [ $1 ] }
    | TYVAR COMMA TyvarList         { $1 :: $3 }

TypeName:
    | IDENT                         { $1 }
    | CTOR                          { $1 }

CtorDecls:
    | CtorDecl                      { [ $1 ] }
    | CtorDecl BAR CtorDecls        { $1 :: $3 }

CtorDecl:
    | CTOR                          { ($1, None) }
    | CTOR OF TypeExpr              { ($1, Some $3) }

// -> 는 오른쪽 결합, * 는 -> 보다 강함, 타입 인자는 뒤에 씀 (int list, 'a option)
TypeExpr:
    | TypeProd                      { makeTuple $1 }
    | TypeProd ARROW TypeExpr       { TFun(makeTuple $1, $3) }

TypeProd:
    | TypeApp                       { [ $1 ] }
    | TypeApp STAR TypeProd         { $1 :: $3 }

TypeApp:
    | TypeAtom                      { $1 }
    | TypeApp TypeName0             { TName($2, [ $1 ]) }
    | LPAREN TypeExpr COMMA TypeArgs RPAREN TypeName0
                                    { TName($6, $2 :: $4) }

// 타입 표기의 타입 이름: int, M.t
TypeName0:
    | IDENT                         { $1 }
    | QIDENT                        { $1 }

// (int, string) pair 의 타입 인자
TypeArgs:
    | TypeExpr                      { [ $1 ] }
    | TypeExpr COMMA TypeArgs       { $1 :: $3 }

TypeAtom:
    | TypeName0                     { TName($1, []) }
    | TYVAR                         { TVar $1 }
    | LPAREN TypeExpr RPAREN        { $2 }

// _ 는 쓰지 않는 인자. 식에서 _ 를 쓸 수 없으므로 "_" 라는 이름으로 묶어도 참조되지 않음.
// (x: t) 는 타입을 적은 인자: (이름, Some (x : t))
Param:
    | IDENT                         { ($1, None) }
    | UNDERSCORE                    { ("_", None) }
    | LPAREN RPAREN                 { ("()", None) }
    | LPAREN IDENT COLON TypeExpr RPAREN
                                    { ($2, Some (annotate (Some ($4, parseState.InputStartPosition 4)) (at parseState (Var $2)))) }
    | LPAREN UNDERSCORE COLON TypeExpr RPAREN
                                    { ("_", Some (annotate (Some ($4, parseState.InputStartPosition 4)) (Var "_"))) }

// 반환 타입 또는 값의 타입: let f x : int = ..., let x : int = ...
OptAnnot:
    |                               { None }
    | COLON TypeExpr                { Some ($2, parseState.InputStartPosition 2) }

Params:
    | Param                         { [ $1 ] }
    | Param Params                  { $1 :: $2 }

// let rec 의 함수 하나: f x y = body
RecBinding:
    | IDENT Params OptAnnot EQUALS SeqExpr
                                    { let param, body = recFunction $2 (annotate $3 $5) in ($1, param, body) }

RecBindings:
    | RecBinding                    { [ $1 ] }
    | RecBinding ANDKW RecBindings  { $1 :: $3 }
