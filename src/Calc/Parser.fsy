%{
open Ast

/// 기본 동작은 위치 없는 Exception "parse error". Program.parse 가 lexbuf 의 위치를 붙이도록 따로 구분되는 예외를 던짐
let parse_error_rich = Some (fun (_: FSharp.Text.Parsing.ParseErrorContext<_>) -> raise Errors.ParseFailure)

/// fun x y -> body  ==  fun x -> fun y -> body
let makeLambda (parameters: string list) (body: Expr) =
    List.foldBack (fun p acc -> Lambda(p, acc)) parameters body

/// [a; b; c]  ==  a :: b :: c :: []
let makeList (items: Expr list) =
    List.foldBack (fun item acc -> Cons(item, acc)) items Nil

/// 패턴 [a; b]  ==  a :: b :: []
let makeListPattern (items: Pattern list) =
    List.foldBack (fun item acc -> PCons(item, acc)) items PNil

let rec patternVars pattern =
    match pattern with
    | PVar name -> [ name ]
    | PCons (h, t) -> patternVars h @ patternVars t
    | PTuple items -> List.collect patternVars items
    | PWildcard | PInt _ | PBool _ | PString _ | PNil -> []

/// 한 패턴 안에서 같은 이름을 두 번 묶으면 오류 (F# 와 같음). pos 는 패턴의 시작 위치
let checkPattern (pos: FSharp.Text.Lexing.Position) pattern =
    let names = patternVars pattern
    match names |> List.countBy id |> List.tryFind (fun (_, n) -> n > 1) with
    | Some (name, _) -> Errors.syntaxError (sprintf "Duplicate variable in pattern: %s" name) pos
    | None -> pattern
%}

%token <int> NUMBER
%token <string> IDENT
%token <string> STRING
%token LET REC IN EQUALS FUN ARROW
%token IF THEN ELSE TRUE FALSE
%token NOTEQUAL LESS GREATER LESSEQUAL GREATEREQUAL
%token AND OR NOT
%token MATCH WITH WHEN BAR CONS LBRACKET RBRACKET SEMI
%token COMMA UNDERSCORE
%token NOBAR
%token PLUS MINUS STAR SLASH LPAREN RPAREN
%token EOF

// 아래로 갈수록 우선순위가 높음.
// IN, ELSE, ARROW 가 가장 낮으므로 let 본문, else 분기, fun 본문은 오른쪽으로 최대한 길게 이어짐:
//   let x = 1 in x + 2           ==  let x = 1 in (x + 2)
//   if c then 1 else 2 + 3       ==  if c then 1 else (2 + 3)
//   fun x -> x + 1               ==  fun x -> (x + 1)
// match 의 마지막 분기 본문도 ARROW 가 가장 낮으므로 오른쪽으로 최대한 길게 이어짐.
// :: 는 오른쪽 결합이고 비교보다 강하고 + - 보다 약함 (F# 와 같음):
//   1 + 2 :: xs  ==  (1 + 2) :: xs,   1 :: 2 :: []  ==  1 :: (2 :: [])
// 비교 연산자는 왼쪽 결합: 1 < 2 < 3 == (1 < 2) < 3 → 평가 시 타입 오류.
// (fsyacc 는 %nonassoc 연산자가 연달아 나와도 오류로 만들지 않고 shift/reduce 충돌을 보고하므로 %left 사용)
// 함수 호출(f x)은 우선순위 선언이 아니라 AppExpr/Atom 계층으로 가장 강하게 묶임.
// match 분기 목록을 끝내는 규칙(Arms: Arm)은 BAR 보다 약함 → 중첩 match 의 뒤 분기는 안쪽 match 것 (F# 와 같음)
%nonassoc NOBAR
%nonassoc BAR
%nonassoc IN ELSE ARROW
%left OR
%left AND
%left EQUALS NOTEQUAL LESS GREATER LESSEQUAL GREATEREQUAL
%right CONS
%left PLUS MINUS
%left STAR SLASH
%nonassoc UMINUS NOT

%start start
%type <Ast.Expr> start

%%

start:
    | Expr EOF                      { $1 }

Expr:
    | AppExpr                       { $1 }
    | LET IDENT EQUALS Expr IN Expr { Let($2, $4, $6) }
    | LET IDENT Params EQUALS Expr IN Expr
                                    { Let($2, makeLambda $3 $5, $7) }
    | LET TuplePattern EQUALS Expr IN Expr
                                    { LetPattern(checkPattern (parseState.InputStartPosition 2) $2, $4, $6) }
    | LET REC IDENT Params EQUALS Expr IN Expr
                                    { LetRec($3, List.head $4, makeLambda (List.tail $4) $6, $8) }
    | FUN Params ARROW Expr         { makeLambda $2 $4 }
    | IF Expr THEN Expr ELSE Expr   { If($2, $4, $6) }
    | MATCH Expr WITH OptBar Arms   { Match($2, $5) }
    | Expr CONS Expr                { Cons($1, $3) }
    | Expr PLUS Expr                { Add($1, $3) }
    | Expr MINUS Expr               { Subtract($1, $3) }
    | Expr STAR Expr                { Multiply($1, $3) }
    | Expr SLASH Expr               { Divide($1, $3) }
    | MINUS Expr %prec UMINUS       { Negate $2 }
    | Expr EQUALS Expr              { Equal($1, $3) }
    | Expr NOTEQUAL Expr            { NotEqual($1, $3) }
    | Expr LESS Expr                { Less($1, $3) }
    | Expr GREATER Expr             { Greater($1, $3) }
    | Expr LESSEQUAL Expr           { LessEqual($1, $3) }
    | Expr GREATEREQUAL Expr        { GreaterEqual($1, $3) }
    | Expr AND Expr                 { And($1, $3) }
    | Expr OR Expr                  { Or($1, $3) }
    | NOT Expr                      { Not $2 }

// 함수 호출: 왼쪽 결합 (f x y == (f x) y)
AppExpr:
    | AppExpr Atom                  { App($1, $2) }
    | Atom                          { $1 }

Atom:
    | NUMBER                        { Number $1 }
    | TRUE                          { Bool true }
    | FALSE                         { Bool false }
    | STRING                        { Str $1 }
    | IDENT                         { Var $1 }
    | LPAREN Expr RPAREN            { $2 }
    | LPAREN Expr COMMA TupleItems RPAREN
                                    { Tuple($2 :: $4) }
    | LBRACKET RBRACKET             { Nil }
    | LBRACKET ListItems RBRACKET   { makeList $2 }

ListItems:
    | Expr                          { [ $1 ] }
    | Expr SEMI ListItems           { $1 :: $3 }

TupleItems:
    | Expr                          { [ $1 ] }
    | Expr COMMA TupleItems         { $1 :: $3 }

// 첫 분기 앞의 | 는 생략 가능
OptBar:
    | BAR                           { () }
    |                               { () }

// 분기 목록. 마지막 분기 본문은 ARROW 가 가장 약하므로 오른쪽 끝까지 이어짐
Arms:
    | Arm %prec NOBAR               { [ $1 ] }
    | Arm BAR Arms                  { $1 :: $3 }

Arm:
    | Pattern ARROW Expr            { (checkPattern (parseState.InputStartPosition 1) $1, None, $3) }
    | Pattern WHEN Expr ARROW Expr  { (checkPattern (parseState.InputStartPosition 1) $1, Some $3, $5) }

// :: 패턴은 오른쪽 결합 (h :: t :: rest == h :: (t :: rest))
Pattern:
    | AtomPattern CONS Pattern      { PCons($1, $3) }
    | AtomPattern                   { $1 }

AtomPattern:
    | IDENT                         { PVar $1 }
    | UNDERSCORE                    { PWildcard }
    | NUMBER                        { PInt $1 }
    | MINUS NUMBER                  { PInt -$2 }
    | TRUE                          { PBool true }
    | FALSE                         { PBool false }
    | STRING                        { PString $1 }
    | LBRACKET RBRACKET             { PNil }
    | LBRACKET PatternItems RBRACKET
                                    { makeListPattern $2 }
    | LPAREN Pattern RPAREN         { $2 }
    | TuplePattern                  { $1 }

TuplePattern:
    | LPAREN Pattern COMMA PatternItemsComma RPAREN
                                    { PTuple($2 :: $4) }

PatternItems:
    | Pattern                       { [ $1 ] }
    | Pattern SEMI PatternItems     { $1 :: $3 }

PatternItemsComma:
    | Pattern                       { [ $1 ] }
    | Pattern COMMA PatternItemsComma
                                    { $1 :: $3 }

// _ 는 쓰지 않는 인자. 식에서 _ 를 쓸 수 없으므로 "_" 라는 이름으로 묶어도 참조되지 않음
Param:
    | IDENT                         { $1 }
    | UNDERSCORE                    { "_" }

Params:
    | Param                         { [ $1 ] }
    | Param Params                  { $1 :: $2 }
