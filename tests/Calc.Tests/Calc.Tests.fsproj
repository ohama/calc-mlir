<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="LexerTests.fs" />
    <Compile Include="ParserTests.fs" />
    <Compile Include="EvalTests.fs" />
    <Compile Include="InferTests.fs" />
    <Compile Include="CompileTests.fs" />
    <Compile Include="Main.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Calc/Calc.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Expecto" Version="11.1.1" />
    <PackageReference Include="Expecto.FsCheck" Version="11.1.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="YoloDev.Expecto.TestSdk" Version="0.16.1" />
  </ItemGroup>

</Project>
